---
import Base from '../../../layouts/Base.astro';
import Wordmark from '../../../components/Wordmark.astro';
import Photo from '../../../components/Photo.astro';
import Menu from '../../../components/Menu.astro';
import Legal from '../../../components/Legal.astro';
import Holdings from '../../../components/content/Holdings.astro';
import People from '../../../components/content/People.astro';
import Contact from '../../../components/content/Contact.astro';
import door from '../../../assets/img/plate-07-door.jpg';
import { company } from '../../../content/site';
import '../../../iterations/07/style.css';
---
<Base title={company.name} noindex class="i07">
  <header class="wrap top">
    <a class="home" href="#main"><Wordmark width={230} alt="Bell Asset Management, top of page" /></a>
    <Menu panel="i07-nav" class="menu-btn" />
    <nav class="nav" id="i07-nav" aria-label="Primary">
      <ul>
        <li><a href="#holdings">Holdings</a></li>
        <li><a href="#people">People</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>
  </header>
  <main id="main">
    <section class="wrap hero" aria-labelledby="h-company">
      <h1 id="h-company" class="thesis" data-reveal>{company.headline}</h1>
    </section>
    <section class="wrap statement-row" aria-label="Statement">
      <figure class="accent" data-reveal>
        <Photo src={door} alt="" sizes="(min-width: 860px) 18rem, 12rem" widths={[400, 640]} />
      </figure>
      <p class="statement" data-reveal>{company.lede}</p>
    </section>
    <section class="wrap sect" id="holdings" aria-labelledby="h-holdings">
      <h2 id="h-holdings" data-reveal>Holdings</h2>
      <div class="holdings"><Holdings level={3} /></div>
    </section>
    <section class="wrap sect" id="people" aria-labelledby="h-people">
      <h2 id="h-people" data-reveal>People</h2>
      <div class="principal"><People level={3} portraitWidth={120} /></div>
    </section>
    <section class="wrap sect" id="contact" aria-labelledby="h-contact">
      <h2 id="h-contact" data-reveal>Contact</h2>
      <div class="contact"><Contact /></div>
    </section>
  </main>
  <footer class="wrap">
    <div class="foot">
      <Wordmark width={200} alt="" eager={false} />
      <Legal class="legal" />
    </div>
  </footer>
</Base>
