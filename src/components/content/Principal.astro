---
import { Image } from 'astro:assets';
import portrait from '../../assets/img/portrait.jpg';
import { principal } from '../../content/site';
interface Props { level?: 2 | 3 | 4; portraitWidth?: number; reveal?: boolean; showName?: boolean }
const { level = 3, portraitWidth = 360, reveal = true, showName = true } = Astro.props;
const H = `h${level}`;
---
<figure class="principal-portrait" data-reveal={reveal ? '' : undefined}>
  <Image src={portrait} alt={principal.portraitAlt} widths={[portraitWidth, portraitWidth * 2]} sizes={`(min-width: 768px) ${portraitWidth}px, 80vw`} formats={['avif', 'webp']} quality={78} loading="lazy" decoding="async" />
</figure>
<div class="principal-text" data-reveal={reveal ? '' : undefined}>
  {showName && <H class="principal-name">{principal.name}</H>}
  {showName && <p class="principal-title meta">{principal.title}</p>}
  <div class="principal-bio">{principal.bio.map((s) => <p>{s}</p>)}</div>
</div>
