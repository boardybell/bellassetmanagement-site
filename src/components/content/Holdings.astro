---
// Holdings cards from src/content/site.ts. Unstyled; iterations style the classes.
// Bell Family Office is rendered inside the Bond Bell & Co LLC card because it is that adviser's
// practice, not a separate company. The adviser paragraph carries data-entity="bbco": the only place
// regulated words may appear.
import { holdings } from '../../content/site';
interface Props { level?: 2 | 3 | 4; reveal?: boolean }
const { level = 3, reveal = true } = Astro.props;
const H = `h${level}`;
const HP = `h${Math.min(level + 1, 6)}`;
---
{holdings.map((h) => (
  <article class={`holding holding--${h.id}`} data-reveal={reveal ? '' : undefined}>
    <p class="holding-place meta">{h.category}</p>
    <H class="holding-name">{h.name}</H>
    <p class="holding-body" data-entity={h.id === 'bbco' ? 'bbco' : undefined}>{h.body}</p>
    {h.href && <p class="holding-link"><a href={h.href} rel="noopener">{h.linkLabel}</a></p>}
    {h.practice && (
      <div class="practice">
        <HP class="practice-name">{h.practice.name}</HP>
        <p class="practice-body">{h.practice.body}</p>
        <p class="practice-link"><a href={h.practice.href} rel="noopener">{h.practice.linkLabel}</a></p>
      </div>
    )}
  </article>
))}
