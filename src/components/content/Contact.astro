---
import { contact } from '../../content/site';
interface Props { reveal?: boolean }
const { reveal = true } = Astro.props;
const [user, domain] = contact.email.split('@');
// Keep hyphenated numbers (suite, ZIP+4) whole: a line may wrap at spaces, never inside a number.
const parts = (line: string) => line.split(/(\S+-\S+)/).filter(Boolean);
---
<div class="contact-item" data-reveal={reveal ? '' : undefined}>
  <p class="contact-label meta">{contact.addressLabel}</p>
  <address class="contact-address">{contact.addressLines.map((l) => <span>{parts(l).map((t) => /-/.test(t) ? <span class="nowrap">{t}</span> : t)}</span>)}</address>
  <p class="contact-note">{contact.solicitationNote}</p>
</div>
<div class="contact-item" data-reveal={reveal ? '' : undefined}>
  <p class="contact-label meta">Email</p>
  <p class="contact-email"><a href={`mailto:${contact.email}`}>{user}@<wbr />{domain}</a></p>
</div>
