---
// Per-iteration 404 body. The page imports its iteration stylesheet; .nf has neutral defaults in base.css.
import Base from '../layouts/Base.astro';
import Wordmark from './Wordmark.astro';
import { company } from '../content/site';
import { url } from '../lib/url';
interface Props { n?: string; cls: string; dark?: boolean }
const { n, cls, dark = false } = Astro.props;
const home = url(n ? `/iterations/${n}/` : '/');
---
<Base title={`Page not found · ${company.name}`} noindex class={`${cls} nf-page${dark ? ' nf-dark' : ''}`} themeColor={dark ? '#16233B' : '#FDF6EC'}>
  <main id="main" class="nf" data-ground={dark ? 'dark' : undefined}>
    <a class="nf-mark" href={home}><Wordmark tone={dark ? 'cream' : 'black'} width={260} alt={`${company.name} home`} /></a>
    <h1>Page not found</h1>
    <p>There is no page at this address.</p>
    <p><a href={home}>Go to the home page</a></p>
  </main>
</Base>
