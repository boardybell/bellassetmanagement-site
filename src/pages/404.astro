---
import Base from '../layouts/Base.astro';
import Wordmark from '../components/Wordmark.astro';
import { url, isProduction } from '../lib/url';
---
<Base title="Page not found · Bell Asset Management" noindex>
  <main id="main" class="nf">
    <a href={url('/')} class="nf-mark"><Wordmark width={280} /></a>
    <h1>Page not found</h1>
    <p>That address does not lead anywhere on this site.</p>
    <p><a href={url(isProduction ? '/' : '/iterations/')}>{isProduction ? 'Go to the home page' : 'Go to the design iterations'}</a></p>
  </main>
</Base>
<style>
  .nf{min-height:100vh;display:grid;place-content:center;justify-items:center;text-align:center;gap:1rem;padding:3rem var(--gutter)}
  .nf-mark{margin-bottom:2rem}
  .nf-mark img{width:min(280px,70vw);height:auto}
  h1{font-size:clamp(2rem,5vw,3rem)}
  p{color:var(--ink)}
  p a{color:var(--ink);text-underline-offset:.2em}
</style>
