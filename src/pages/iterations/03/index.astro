---
import Base from '../../../layouts/Base.astro';
import Wordmark from '../../../components/Wordmark.astro';
import Photo from '../../../components/Photo.astro';
import Menu from '../../../components/Menu.astro';
import Legal from '../../../components/Legal.astro';
import Holdings from '../../../components/content/Holdings.astro';
import Principal from '../../../components/content/Principal.astro';
import Contact from '../../../components/content/Contact.astro';
import plate from '../../../assets/img/plate-03-stair.jpg';
import { company, statement } from '../../../content/site';
import { iterations } from '../../../iterations/registry';
import '../../../iterations/03/style.css';
---
<Base title={company.name} noindex class="i03">
  <header class="head">
    <h1><Wordmark width={380} /></h1>
    <Menu panel="i03-nav" class="menu-btn" />
    <nav class="nav" id="i03-nav" aria-label="Primary">
      <ul>
        <li><a href="#holdings">Holdings</a></li>
        <li><a href="#principal">Principal</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>
  </header>
  <main id="main">
    <section class="hero" aria-label="Statement">
      <div>
        <p class="kicker meta" data-reveal>{company.descriptor}</p>
        <p class="thesis" data-reveal>{iterations[2].thesis}</p>
        <p class="statement" data-reveal>{statement}</p>
      </div>
      <figure class="plate" data-reveal>
        <div class="plate-frame"><Photo src={plate} alt="" priority sizes="(min-width: 900px) 25rem, 20rem" widths={[400, 640, 819]} /></div>
        <figcaption class="caption">Plate I · Limestone stair</figcaption>
      </figure>
    </section>

    <section class="sect" id="holdings" aria-labelledby="h-holdings">
      <div><p class="sect-num meta">I</p><h2 id="h-holdings">Holdings</h2></div>
      <div class="ledger"><Holdings level={3} /></div>
    </section>

    <section class="sect" id="principal" aria-labelledby="h-principal">
      <div><p class="sect-num meta">II</p><h2 id="h-principal">Principal</h2></div>
      <div class="principal"><Principal level={3} portraitWidth={208} /></div>
    </section>

    <section class="sect" id="contact" aria-labelledby="h-contact">
      <div><p class="sect-num meta">III</p><h2 id="h-contact">Contact</h2></div>
      <div class="contact"><Contact /></div>
    </section>
  </main>
  <footer>
    <div class="foot">
      <Wordmark width={200} alt="" eager={false} />
      <Legal class="legal" />
    </div>
  </footer>
</Base>
