---
import Base from '../../layouts/Base.astro';
import Wordmark from '../../components/Wordmark.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { iterations } from '../../iterations/registry';
import { url } from '../../lib/url';

// Screenshots are captured by scripts/gallery-shots.mjs after fonts load and reveals complete.
const shots = import.meta.glob<{ default: ImageMetadata }>('../../assets/gallery/*.png', { eager: true });
const shot = (n: string, kind: 'desktop' | 'mobile') => shots[`../../assets/gallery/${n}-${kind}.png`]?.default;
---
<Base title="Design iterations · Bell Asset Management" description="Ten design iterations for the Bell Asset Management website, for internal review." noindex>
  <header class="g-head">
    <Wordmark width={300} />
  </header>
  <main id="main" class="g-main">
    <h1>Design iterations</h1>
    <p class="g-lede">Ten complete builds in four families. Each link opens the live iteration. Choose by number; hybrids are welcome and become iteration 11.</p>
    <ol class="g-grid">
      {iterations.map((it) => {
        const d = shot(it.n, 'desktop'); const m = shot(it.n, 'mobile');
        return (
          <li class="g-card">
            <a class="g-shots" href={url(`/iterations/${it.n}/`)} tabindex="-1" aria-hidden="true">
              {d ? <Image src={d} alt="" width={720} class="g-desk" /> : <span class="g-desk g-missing">Screenshot pending</span>}
              {m ? <Image src={m} alt="" width={180} class="g-mob" /> : null}
            </a>
            <div class="g-meta">
              <p class="g-num meta"><span>{it.n}</span> {it.family}</p>
              <h2><a href={url(`/iterations/${it.n}/`)}>{it.name}</a></h2>
              <p class="g-thesis">{it.thesis}</p>
              <p class="g-why">{it.rationale}</p>
              <p class="g-pages meta">{it.pages.length === 1 ? 'Single page' : `${it.pages.length} pages: ${it.pages.map((p) => p.label).join(', ')}`}</p>
              <p class="g-full meta">Full-page screenshots: <a href={url(`/gallery/${it.n}-desktop-full.webp`)}>desktop</a> · <a href={url(`/gallery/${it.n}-mobile-full.webp`)}>mobile</a></p>
            </div>
          </li>
        );
      })}
    </ol>
  </main>
  <footer class="g-foot"><p>Internal review only. Not indexed.</p></footer>
</Base>
<style>
  .g-head{padding:2.5rem var(--gutter) 0;display:flex;justify-content:center}
  .g-head img{width:min(300px,70vw);height:auto}
  .g-main{max-width:84rem;margin:0 auto;padding:3rem var(--gutter) 4rem}
  h1{font-size:clamp(2rem,4vw,3rem);text-align:center}
  .g-lede{max-width:var(--measure);margin:1rem auto 0;text-align:center}
  .g-grid{list-style:none;padding:0;margin:3.5rem 0 0;display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,34rem),1fr));gap:3.5rem 3rem}
  .g-card{display:grid;gap:1.25rem;border-top:1px solid var(--gold);padding-top:1.25rem}
  .g-shots{position:relative;display:block;aspect-ratio:16/10;overflow:hidden;background:var(--navy);outline-offset:4px}
  .g-desk{width:100%;height:100%;object-fit:cover;object-position:top}
  .g-mob{position:absolute;right:4%;bottom:0;width:22%;height:88%;object-fit:cover;object-position:top;border:1px solid var(--rule);box-shadow:0 0 0 4px var(--cream)}
  .g-missing{display:grid;place-items:center;color:var(--cream);font-family:var(--font-label);font-size:.8125rem;letter-spacing:.1em;text-transform:uppercase}
  .g-num{font-family:var(--font-label);font-weight:500;font-size:.75rem;letter-spacing:.14em;text-transform:uppercase;color:var(--gold-ink)}
  .g-num span{color:var(--ink);margin-right:.5rem}
  h2{font-size:1.75rem;margin-top:.25rem}
  h2 a{text-decoration:none}
  h2 a:hover{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:.2em}
  .g-thesis{font-family:var(--font-display);font-size:1.25rem;line-height:1.35;margin-top:.5rem}
  .g-why{margin-top:.75rem;max-width:var(--measure)}
  .g-pages{margin-top:.75rem;font-family:var(--font-label);font-weight:500;font-size:.75rem;letter-spacing:.1em;text-transform:uppercase;color:var(--warm)}
  .g-full{margin-top:.5rem;font-family:var(--font-label);font-weight:500;font-size:.75rem;letter-spacing:.1em;text-transform:uppercase;color:var(--warm)}
  .g-full a{color:var(--ink);text-underline-offset:.2em;text-decoration-color:var(--gold)}
  .g-foot{border-top:1px solid var(--rule);padding:2rem var(--gutter);text-align:center;color:var(--warm);font-size:.9375rem}
</style>
