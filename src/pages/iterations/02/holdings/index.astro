---
import Layout from '../../../../iterations/02/Layout.astro';
import Holdings from '../../../../components/content/Holdings.astro';
import { company } from '../../../../content/site';
---
<Layout title={`Holdings · ${company.name}`} current="holdings/" description="The operating companies held by Bell Asset Management.">
  <div class="page">
    <p class="eyebrow meta" data-reveal>Operating companies</p>
    <h1 data-reveal>Holdings</h1>
    <p class="lede" data-reveal>Bell Asset Management holds the operating businesses below. Each links to its own site.</p>
    <div class="holdings"><Holdings level={2} /></div>
  </div>
</Layout>
