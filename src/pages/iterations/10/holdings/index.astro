---
import Layout from '../../../../iterations/10/Layout.astro';
import Holdings from '../../../../components/content/Holdings.astro';
import { company, holdingsIntro } from '../../../../content/site';
---
<Layout title={`Holdings · ${company.name}`} current="holdings/" description="Holdings of Bell Asset Management: Bond Bell & Co LLC, its Bell Family Office practice, and real estate and capital assets.">
  <div class="pagehead" data-ground="dark"><p class="eyebrow meta">Businesses and assets</p><h1>Holdings</h1></div>
  <div class="dissolve" aria-hidden="true"></div>
  <div class="body">
    <p class="lede" data-reveal>{holdingsIntro}</p>
    <div class="holdings"><Holdings level={2} /></div>
  </div>
</Layout>
