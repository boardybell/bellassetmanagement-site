---
import Layout from '../../../iterations/10/Layout.astro';
import Photo from '../../../components/Photo.astro';
import Contact from '../../../components/content/Contact.astro';
import hero from '../../../assets/img/hero-10-arcade.jpg';
import { company } from '../../../content/site';
import { url } from '../../../lib/url';
---
<Layout title={company.name} current="">
  <section class="hero" data-ground="dark" aria-label="Thesis">
    <Photo src={hero} alt="" priority class="hero-img" />
    <div class="hero-copy">
      <p class="thesis" data-reveal>{company.headline}</p>
      <p class="hero-lede" data-reveal>{company.lede}</p>
    </div>
  </section>
  <div class="dissolve" aria-hidden="true"></div>
  <div class="body">
    <div class="links" data-reveal>
      <a href={url('/iterations/10/holdings/')}><strong>Holdings</strong><span>{'Bond Bell & Co LLC, real estate, and capital assets.'}</span></a>
      <a href={url('/iterations/10/people/')}><strong>People</strong><span>Bond Bell, principal, and Shirley Lau Scott, administrator.</span></a>
    </div>
    <section class="contact-sect" id="contact" aria-labelledby="h-contact">
      <h2 id="h-contact" data-reveal>Contact</h2>
      <div class="contact"><Contact /></div>
    </section>
  </div>
</Layout>
